generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vessel {
  id         String   @id @default(uuid())
  name       String
  currentLat Float?
  currentLng Float?
  status     String   @default("AT_PORT") // AT_PORT, IN_TRANSIT, MAINTENANCE
  voyages    Voyage[]
  crew       CrewMember[]
}

model Voyage {
  id              String   @id @default(uuid())
  vesselId        String
  vessel          Vessel   @relation(fields: [vesselId], references: [id])
  originPort      String
  destinationPort String
  departureTime   DateTime?
  status          String   @default("PLANNED") // PLANNED, ONGOING, COMPLETED
  runningCost     Float    @default(0.0)
  runningCostCents Int     @default(0)
  lastTickAt      DateTime @default(now())
  costConfigId    String?
  costConfig      VoyageCostConfig? @relation(fields: [costConfigId], references: [id])
  cargo           CargoItem[]
}

model VoyageCostConfig {
  id                      String @id @default(uuid())
  fuelPriceUsdPerTon      Float
  fuelConsumptionTph      Float   // tonnes per hour
  portFeesUsd             Float   // fixed
  voyages                 Voyage[]
}

model CargoItem {
  id              String   @id @default(uuid())
  voyageId        String?
  voyage          Voyage?  @relation(fields: [voyageId], references: [id])
  weightKg        Float
  contents        String
  destinationPort String
  owner           String
  qrCode          String   @unique
  loadStatus      String   @default("MANIFESTED") // MANIFESTED, LOADED, SECURED, OFFLOADED, DAMAGED

  // ── NEW ARRANGEMENT FIELDS ──
  cargoId         String   @default("")      // "CARGO-0001"
  label           String   @default("")      // "Steel Coils – Lot A"
  type            String   @default("STANDARD")  // STANDARD | REFRIGERATED | HAZMAT | LIQUID_BULK
  lengthM         Float    @default(6.1)
  widthM          Float    @default(2.4)
  heightM         Float    @default(2.6)
  hazardClass     String   @default("NONE") // NONE | FLAMMABLE | TOXIC | EXPLOSIVE | CORROSIVE
  deckSlotId      String?                   // "B3-R2-C4" — null = unplaced
  notes           String?
}

model CrewMember {
  id          String   @id @default(uuid())
  vesselId    String?
  vessel      Vessel?  @relation(fields: [vesselId], references: [id])
  name        String
  role        String
  hourlyRate  Float    @default(15.0) // USD/hr
  isActive    Boolean  @default(true)
  currentZone String?
  shiftStart  DateTime?
  shifts      ShiftLog[]
}

model ShiftLog {
  id        String   @id @default(uuid())
  crewId    String
  crew      CrewMember @relation(fields: [crewId], references: [id])
  startTime DateTime
  endTime   DateTime?

  @@index([crewId])
}

model PortDirectory {
  id                 String   @id @default(uuid())
  name               String   @unique
  lat                Float
  lng                Float
  fuelPriceUsdPerTon Float
  portFeesUsd        Float
}

model NewsCache {
  id        String   @id @default(uuid())
  region    String
  fetchedAt DateTime
  payload   Json
}
